#!/bin/sh
# Bash-guard hook launcher. Fails closed (deny) when prereqs are missing,
# including python3 itself (the .py hook can't check for python3 because
# it can't run without it). There is deliberately no environment-variable
# bypass: one exported variable silently disabling the enforcement layer
# is exactly the hole a guard must not have. To disable the guard, use
# the visible, auditable path: /plugin disable bash-guard@claude-code-recipes.

set -eu

emit_deny() {
    reason="$1"
    printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"bash-guard: %s"}}\n' "$reason"
    exit 0
}

if ! command -v python3 >/dev/null 2>&1; then
    emit_deny "python3 not on PATH. Install Python 3.10+, or disable the plugin via /plugin disable bash-guard@claude-code-recipes."
fi

dir="$(dirname "$0")"
exec python3 "$dir/../scripts/bash_guard_hook.py" "$@"
