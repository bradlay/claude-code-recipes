#!/bin/sh
# Stop hook launcher. Always fail-open: if python3 is missing, the session
# ends without the advisory (no security implication; this hook is purely
# informational).

set -eu

if ! command -v python3 >/dev/null 2>&1; then
    exit 0
fi

dir="$(dirname "$0")"
exec python3 "$dir/../scripts/quota_advisory_hook.py" "$@"
